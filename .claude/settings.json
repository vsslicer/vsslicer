{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skills/taskboard/scripts/hook.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ],
        "matcher": "Agent"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skills/taskboard/scripts/hook.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/skills/taskboard/scripts/hook.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
