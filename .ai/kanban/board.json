{
  "name": "VSSlicer",
  "key": "VSS",
  "columns": [
    {
      "id": "backlog",
      "title": "Backlog"
    },
    {
      "id": "next",
      "title": "Next"
    },
    {
      "id": "todo",
      "title": "Ready to start"
    },
    {
      "id": "doing",
      "title": "In progress"
    },
    {
      "id": "review",
      "title": "In review"
    },
    {
      "id": "done",
      "title": "Done"
    }
  ],
  "active": [
    "doing",
    "review"
  ],
  "done": "done",
  "items": [
    {
      "kind": "initiative",
      "folder": "initiatives",
      "prefix": "I",
      "title": "Initiatives"
    },
    {
      "kind": "epic",
      "folder": "epics",
      "prefix": "E",
      "title": "Epics",
      "parent": "initiative"
    },
    {
      "kind": "story",
      "folder": "stories",
      "prefix": "US",
      "title": "Stories",
      "parent": "epic"
    },
    {
      "kind": "milestone",
      "folder": "milestones",
      "prefix": "M",
      "title": "Milestones"
    },
    {
      "kind": "sprint",
      "folder": "sprints",
      "prefix": "SP",
      "title": "Sprints",
      "parent": "milestone"
    },
    {
      "kind": "decision",
      "folder": "decisions",
      "prefix": "D",
      "title": "Decisions"
    }
  ],
  "fields": [
