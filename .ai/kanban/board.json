      "label": "Model",
      "kind": "select",
      "tile": true,
      "options": [
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    {
      "name": "area",
      "label": "Area",
      "kind": "multiselect",
      "options": [
        {
          "value": "slicer",
          "color": "indigo"
        },
        {
          "value": "3mf",
