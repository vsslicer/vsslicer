      ]
    },
    {
      "name": "story",
      "label": "Story",
      "kind": "item",
      "item": "story"
    },
    {
      "name": "milestone",
      "label": "Milestone",
      "kind": "item",
      "item": "milestone"
    },
    {
      "name": "sprint",
      "label": "Sprint",
      "kind": "item",
      "item": "sprint"
    },
    {
      "name": "owner",
      "label": "Owner",
      "kind": "text"
    },
    {
      "name": "depends_on",
      "label": "Depends on",
      "kind": "cards"
    },
    {
      "name": "docs",
      "label": "Docs",
      "kind": "docs"
    },
    {
      "name": "source",
      "label": "Source",
      "kind": "text"
    }
  ],
  "points": {
    "XS": 1,
    "S": 2,
    "M": 3,
    "L": 5,
    "XL": 8
  },
  "docs": [
    "docs",
    ".ai/plans"
  ],
  "notes": ".reference/notes/{ticket}-*.md",
  "stall_minutes": 20,
  "gstack": {
    "todos": "TODOS.md",
    "group_by": "area"
  },
  "template": "What the task is for, in a sentence or two.\n\n## Acceptance criteria\n\n- [ ] What has to be true for the task to be done\n\n## Tasks\n\n- [ ] The work, broken down, in order\n\n## Progress\n\nNot started.\n",
  "projects": {
    "PLT": ".ai/kanban/projects/platform",
    "GCP": ".ai/kanban/projects/gcode",
    "VWR": ".ai/kanban/projects/viewer",
    "PRF": ".ai/kanban/projects/profiles",
    "PRN": ".ai/kanban/projects/printers",
    "SLC": ".ai/kanban/projects/slicer",
    "FIL": ".ai/kanban/projects/filament"
  },
  "sprint_close": {
    "requires": [
      ".ai/audits/{sprint}-audit.md",
      ".ai/retros/{sprint}-retro.md"
    ]
  },
  "runner": {
    "model": "opus",
    "permission_mode": "auto",
    "prompt": "You are the coordinator for sprint {sprint} of VSSlicer. Read .ai/instructions.md, .ai/skills/sprint-cycle/SKILL.md (step 0 first: the owner's answers in `board.py inbox`), .ai/plans/estimation.md, and the previous sprint's retro and audit. Run the sprint cycle for {sprint} from start to close without stopping between phases: owner questions become `board.py ask` items, never blockers, and you never take an outward-facing step. Finish with `close-sprint {sprint} --next <the next sprint>` and commit `Board: close {sprint}`. Dispatch workers and reviewers as foreground Agent calls, several in one message: this headless process ends when your turn ends, and background agents would end with it."
  }
}
