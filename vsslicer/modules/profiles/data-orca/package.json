{
  "name": "@vsslicer/profiles-data-orca",
  "version": "0.1.0",
  "description": "Pinned OrcaSlicer and Bambu Studio JSON profile trees (data only).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "scripts/tree.mjs",
    "LICENSE",
    "LICENSE-OrcaSlicer",
    "LICENSE-BambuStudio",
    "NOTICE",
    "PROVENANCE.md",
    "README.md",
    "source.commit",
    "tree.sha256"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc --noEmit -p tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "node scripts/generate.mjs && pnpm build",
    "generate": "node scripts/generate.mjs",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "regenerate": "node scripts/regenerate.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vsslicer/tooling": "^0.8.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prettier": "@vsslicer/tooling/prettier"
}
