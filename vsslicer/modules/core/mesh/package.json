{
  "name": "@vsslicer/mesh",
  "version": "0.1.0",
  "description": "Triangle meshes for VSSlicer: the IndexedMesh model and typed mesh errors (domain), with parsers and statistics to follow.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "test/bench/budget.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc --noEmit -p tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "pnpm build",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "fixture:large": "node scripts/generate-large-fixture.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vsslicer/tooling": "^0.8.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prettier": "@vsslicer/tooling/prettier",
  "dependencies": {
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  }
}
