{
  "name": "@vsslicer/gcode-planner",
  "version": "0.4.0",
  "description": "Motion planner contract for G-code timing: MachineLimits resolution with sources, the Planner interface, Timing (start times, per-layer and per-role tables, checkpoints), a cancellable runner and a constant-speed reference planner.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "scripts": {
    "prepack": "pnpm build",
    "lint": "eslint . && prettier --check . && tsc --noEmit -p tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@vsslicer/gcode-api": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vsslicer/tooling": "^0.8.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prettier": "@vsslicer/tooling/prettier"
}
