{
  "name": "@vsslicer/tooling",
  "version": "0.3.0",
  "description": "Shared VSSlicer tooling: TypeScript base config and the extension bundler shared vitest config (ESLint config lands here).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./vitest": "./vitest.config.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "vsslicer-bundle": "bin/vsslicer-bundle.mjs"
  },
  "files": [
    "tsconfig.base.json",
    "vitest.config.mjs",
    "bin",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "scripts": {
    "lint": "node --check bin/vsslicer-bundle.mjs",
    "build": "node --check bin/vsslicer-bundle.mjs",
    "test": "node --test test/"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
