{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./feeder.json",
  "title": "feeder",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "./defs.json#/$defs/id"
    },
    "inherits": {
      "type": "array",
      "items": {
        "$ref": "./defs.json#/$defs/id"
      }
    },
    "abstract": {
      "type": "boolean"
    },
    "when": {
      "$ref": "./defs.json#/$defs/condition"
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "./defs.json#/$defs/override"
      }
    },
    "settings": {
      "$ref": "./defs.json#/$defs/settings"
    },
    "renamed_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "$ref": "./defs.json#/$defs/meta"
    },
    "slots": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "mmu",
        "ams",
        "toolchanger"
      ]
    }
  },
  "required": [
    "id",
    "slots"
  ],
  "additionalProperties": false
}
