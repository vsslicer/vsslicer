{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "G-code",
  "scopeName": "source.gcode",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#placeholder" },
    { "include": "#line-number" },
    { "include": "#message" },
    { "include": "#meta-keyword" },
    { "include": "#code" },
    { "include": "#extended-command" },
    { "include": "#key-value" },
    { "include": "#parameter" },
    { "include": "#number" },
    { "include": "#checksum" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.semicolon.gcode", "match": ";.*$" },
        { "name": "comment.block.parenthesis.gcode", "begin": "\\(", "end": "\\)|$" }
      ]
    },
    "string": {
      "name": "string.quoted.double.gcode",
      "begin": "\"",
      "end": "\"(?!\")|$",
      "patterns": [{ "name": "constant.character.escape.gcode", "match": "\"\"|''" }]
    },
    "placeholder": {
      "patterns": [
        {
          "name": "meta.embedded.expression.braces.gcode",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.gcode" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.gcode" } },
          "patterns": [{ "include": "#expression" }]
        },
        {
          "name": "meta.embedded.expression.brackets.gcode",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.gcode" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.gcode" } },
          "patterns": [{ "include": "#expression" }]
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#string" },
        { "include": "#placeholder" },
        { "name": "constant.numeric.gcode", "match": "(?<![\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?![\\w.])" },
        { "name": "constant.language.gcode", "match": "\\b(?:true|false|null|none)\\b" },
        { "name": "keyword.operator.gcode", "match": "[-+*/%^<>=!&|?:~]+" },
        { "name": "variable.other.gcode", "match": "[A-Za-z_][A-Za-z0-9_.]*" }
      ]
    },
    "line-number": {
      "name": "constant.numeric.line-number.gcode",
      "match": "^\\s*[Nn]\\d+"
    },
    "message": {
      "match": "(?<![\\w.])([Mm]11[78])(\\s+)([^;\\n]*)",
      "captures": {
        "1": { "name": "entity.name.function.gcode" },
        "3": { "name": "string.unquoted.message.gcode" }
      }
    },
    "meta-keyword": {
      "name": "keyword.control.meta.gcode",
      "match": "^\\s*\\K(?:if|elif|else|while|break|continue|var|set|global|echo|abort|skip)(?![\\w.=])"
    },
    "code": {
      "patterns": [
        { "name": "entity.name.function.gcode", "match": "(?<![\\w.])[GgMm]\\d+(?:\\.\\d+)?(?![\\w.])" },
        { "name": "entity.name.function.tool.gcode", "match": "(?<![\\w.])[Tt]\\d+(?![\\w.])" }
      ]
    },
    "extended-command": {
      "name": "entity.name.function.extended.gcode",
      "match": "^\\s*\\K(?![NnGgMmTt]\\d)[A-Za-z_][A-Za-z_][A-Za-z0-9_]*(?![\\w.=])"
    },
    "key-value": {
      "match": "(?<![\\w.])([A-Za-z_][A-Za-z0-9_]*)(=)",
      "captures": {
        "1": { "name": "variable.parameter.gcode" },
        "2": { "name": "keyword.operator.assignment.gcode" }
      }
    },
    "parameter": {
      "patterns": [
        {
          "match": "(?<![\\w.])([A-Za-z])([-+]?(?:\\d+\\.?\\d*|\\.\\d+))(?![\\w.])",
          "captures": {
            "1": { "name": "variable.parameter.gcode" },
            "2": { "name": "constant.numeric.gcode" }
          }
        },
        { "name": "variable.parameter.gcode", "match": "(?<![\\w.])[A-Za-z](?![\\w.=])" }
      ]
    },
    "number": {
      "name": "constant.numeric.gcode",
      "match": "(?<![\\w.])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?![\\w.])"
    },
    "checksum": {
      "name": "keyword.other.checksum.gcode",
      "match": "\\*\\d+"
    }
  }
}
