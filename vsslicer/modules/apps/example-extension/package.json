{
  "name": "@vsslicer/example-extension",
  "displayName": "VSSlicer Example",
  "version": "0.7.3",
  "description": "Sample VSSlicer VS Code extension (presentation layer).",
  "publisher": "vsslicer",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/<owner>/VSSlicer/tree/example-extension@0.7.0/vsslicer/modules/example-extension",
  "vsslicer": {
    "sizeBudgetKB": 200
  },
  "main": "dist/extension.js",
  "files": [
    "dist",
    "!dist/*.meta.json",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "activationEvents": [
    "onCommand:vsslicer.example.hello",
    "onCommand:vsslicer.example.webview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vsslicer.example.hello",
        "title": "VSSlicer: Hello"
      },
      {
        "command": "vsslicer.example.webview",
        "title": "VSSlicer: Open Sample Webview"
      }
    ]
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc",
    "build": "tsc && vsslicer-bundle && esbuild src/presentation/webview/main.ts --bundle --platform=browser --format=iife --target=es2023 --sourcemap --outfile=dist/webview.js --metafile=dist/webview.meta.json && third-party-notices dist/extension.meta.json dist/webview.meta.json",
    "prepack": "pnpm build",
    "package": "vsslicer-package",
    "test": "node --test test/*.test.ts",
    "test:integration": "pnpm build && esbuild test/integration/*.test.ts --bundle --platform=node --format=cjs --external:vscode --outdir=dist-test && vsslicer-test-vscode",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vsslicer/test-vscode": "^0.2.3",
    "@vsslicer/tooling": "^0.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@vsslicer/example": "^0.3.2"
  },
  "prettier": "@vsslicer/tooling/prettier"
}
