{
  "name": "@vsslicer/printers-extension",
  "displayName": "VSSlicer Printers",
  "version": "0.0.3",
  "description": "VSSlicer printer connectivity (VS Code extension, presentation layer).",
  "publisher": "vsslicer",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/vsslicer/vsslicer/tree/printers-extension@0.0.2/vsslicer/modules/apps/printers",
  "vsslicer": {
    "sizeBudgetKB": 200
  },
  "extensionKind": [
    "ui"
  ],
  "main": "dist/extension.js",
  "files": [
    "dist",
    "!dist/*.meta.json",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24",
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "activationEvents": [
    "onCommand:vsslicer.printers.about"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vsslicer.printers.about",
        "title": "VSSlicer: About Printers Extension"
      }
    ]
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc",
    "build": "tsc && vsslicer-bundle && third-party-notices dist/extension.meta.json",
    "prepack": "pnpm build",
    "package": "vsslicer-package",
    "test": "node --test test/*.test.ts",
    "test:integration": "pnpm build && esbuild test/integration/*.test.ts --bundle --platform=node --format=cjs --external:vscode --outdir=dist-test && vsslicer-test-vscode",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vsslicer/test-vscode": "^0.2.4",
    "@vsslicer/tooling": "^0.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "prettier": "@vsslicer/tooling/prettier"
}
