{
  "name": "@vsslicer/webview-kit",
  "version": "0.1.0",
  "description": "Webview plumbing shared by VSSlicer extensions: host (Node), webview and gl (browser) entry points and the transport schema version.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./webview": {
      "types": "./dist/webview/index.d.ts",
      "default": "./dist/webview/index.js"
    },
    "./gl": {
      "types": "./dist/gl/index.d.ts",
      "default": "./dist/gl/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "registry": "http://localhost:4873/"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && tsc --noEmit -p tsconfig.test.json",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.gl.json",
    "prepack": "pnpm build",
    "test": "tsc --noEmit -p tsconfig.test.json && pnpm build && vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vsslicer/tooling": "^0.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "prettier": "@vsslicer/tooling/prettier"
}
